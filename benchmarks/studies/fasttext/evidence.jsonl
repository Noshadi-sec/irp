{"actor":"cli","data":{"paper":{"abstract":"This paper explores a simple and efficient baseline for text classification. Our experiments show that our fast text classifier fastText is often on par with deep learning classifiers in terms of accuracy, and many orders of magnitude faster for training and evaluation. We can train fastText on more than one billion words in less than ten minutes using a standard multicore~CPU, and classify half a million sentences among~312K classes in less than a minute.","arxiv_id":"1607.01759","authors":["Armand Joulin","Edouard Grave","Piotr Bojanowski","Tomas Mikolov"],"counts":{"algorithms":0,"equations":1,"figures":1,"lines":455,"sections":8,"tables":5},"doi":null,"files":[{"bytes":6482,"path":"paper/index.json","sha256":"sha256:6508657be28d51d572b3ebbadeea52c6d7e3bdf36d285028d10293939375ae08"},{"bytes":71614,"path":"paper/paper.pdf","sha256":"sha256:6cbcf620c2537ed54dfb9ed0d843a83689b82dc41dcd305bfb2e82425d4d7906"},{"bytes":22341,"path":"paper/source-download.tar.gz","sha256":"sha256:fd1c15d81f7d6bbc34e8ae40ed4b0f722ad7f188d585c05c09a7d041a543a7a2"},{"bytes":33769,"path":"paper/text.json","sha256":"sha256:e0a3c3f58047af57ef98d9764258bc33167f91af13ea7f0ac14ade0a1bf692b7"},{"file_count":6,"path":"paper/source","sha256":"sha256:89e96edebdf77a7b19d343c1d82c636a4a26c6b251a4c4f4cef6bd73f9b969a6","tree":true}],"kind":"arxiv","links":{"abs":"https://arxiv.org/abs/1607.01759v3","pdf":"https://arxiv.org/pdf/1607.01759v3","source":"https://arxiv.org/e-print/1607.01759v3"},"main_file":"source/emnlp2016.tex","pages":5,"parser":"latex","primary_category":"cs.CL","published":"2016-07-06T19:40:15Z","ref":"1607.01759","source_archive_kind":"tar","source_format":"latex","title":"Bag of Tricks for Efficient Text Classification","updated":"2016-08-09T17:38:43Z","version":"v3"}},"hash":"sha256:d17a31581733a29d8ac266096188490fca1e57b804935de5c51cb2ca3823ebd6","prev":"sha256:831d5ecd74441ce78146ee45d8f6726e0fc0c8c242e4ff17f4c5a33f9109205d","schema":1,"s